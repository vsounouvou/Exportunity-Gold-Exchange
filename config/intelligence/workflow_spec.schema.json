{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exportunity.ai/schemas/workflow_spec.schema.json",
  "title": "WorkflowSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workflowId", "tenantId", "moduleId", "steps"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "workflowId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "tenantId": {
      "type": "integer",
      "minimum": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "managerTier": {
      "type": "string",
      "enum": ["SUPER", "MANAGER"],
      "default": "MANAGER"
    },
    "executionTier": {
      "type": "string",
      "enum": ["EXECUTION"],
      "default": "EXECUTION"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "scriptKey", "input"],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "scriptKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "expectedOutput": {
            "type": "object",
            "additionalProperties": true
          },
          "onFailure": {
            "type": "string",
            "enum": ["STOP", "RETRY", "ESCALATE"],
            "default": "STOP"
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "default": 0
          }
        }
      }
    }
  }
}
