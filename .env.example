# Example environment variables (NO SECRETS)
# Copy to `.env.local` (dev) or your secrets manager (prod).

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Public base URL (used for webhook URL generation + signature verification)
# Recommended: set this in production.
PUBLIC_BASE_URL=https://boursedelor.com

# Multi-tenant host routing.
# Add AGOOJIYE on the shared VPS without changing the default tenant.
TENANT_DEFAULT=exportunity
TENANT_HOST_MAP=agoojiye.com=agoojye,www.agoojiye.com=agoojye,app.agoojiye.com=agoojye,admin.agoojiye.com=agoojye

# MindBase + first-login password setup
APP_BASE_URL=https://mindbase.cloud
PASSWORD_SETUP_BASE_URL=https://mindbase.cloud
PASSWORD_HASH_ROUNDS=10
MINDBASE_DEMO_USER_PASSWORD=MindbaseDemo123!

# FX provider + policy
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_DURATION_MS=1800000
FX_STALE_AFTER_MS=7200000
FX_OVERRIDE_MAX_DRIFT_PERCENT=50

# --- Exportunity staging host protection ---
# clone.exportunity.net is blocked by default unless one of these is configured:
# 1) shared token header: X-Staging-Token
# 2) HTTP Basic Auth credentials
CLONE_STAGING_ACCESS_TOKEN=
CLONE_STAGING_BASIC_AUTH_USER=
CLONE_STAGING_BASIC_AUTH_PASSWORD=

# --- Twilio (SMS / WhatsApp / Voice / Verify) ---
# Required for any Twilio usage:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Approved production WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+16079486041

# SMS sender (Twilio SMS-capable number) OR Messaging Service SID
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional voice
TWILIO_VOICE_FROM=+1XXXXXXXXXX
TWILIO_VOICE_FORWARD_TO=+1XXXXXXXXXX
TWILIO_VOICE_VOICEMAIL_ENABLED=true

# --- Voice transcription provider chain ---
# Server-first provider routing. Browser speech is handled on client as fallback.
TRANSCRIPTION_PROVIDER_PRIMARY=whisper_service
WHISPER_SERVICE_URL=http://transcription:8080/transcribe
TRANSCRIPTION_PROVIDER_SECONDARY=browser_speech
TRANSCRIPTION_PROVIDER_TERTIARY=openai
OPENAI_TRANSCRIPTION_ENABLED=false

# Optional Verify (OTP)
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook URL config (optional)
# If set, this is preferred over PUBLIC_BASE_URL / TWILIO_APP_BASE_URL for callbacks + signature validation.
TWILIO_STATUS_CALLBACK_BASE_URL=https://exportunity.net
# Which path Twilio should call for message status updates.
TWILIO_WEBHOOK_PATH=/api/webhooks/twilio/status

# Sandbox mode indicator (UI badge only)
TWILIO_SANDBOX_MODE=false

# Webhook signature secret (optional; falls back to TWILIO_AUTH_TOKEN if not set)
TWILIO_WEBHOOK_SIGNING_SECRET=generate_a_long_random_secret

# --- Payments (KKiaPay + Flutterwave, multi-tenant) ---
# Global mode selector used by Flutterwave resolver (fallbacks to NODE_ENV and tenant-specific modes)
PAYMENT_MODE=sandbox

# Flutterwave v3 keys (Bourse de l'Or tenant, legacy hosted checkout)
FLW_PUBLIC_KEY_BDO_SANDBOX=
FLW_SECRET_KEY_BDO_SANDBOX=
FLW_ENCRYPTION_KEY_BDO_SANDBOX=
FLW_WEBHOOK_HASH_BDO_SANDBOX=
FLW_PUBLIC_KEY_BDO_LIVE=
FLW_SECRET_KEY_BDO_LIVE=
FLW_ENCRYPTION_KEY_BDO_LIVE=
FLW_WEBHOOK_HASH_BDO_LIVE=

# Flutterwave v3 keys (Exportunity tenant, legacy hosted checkout)
FLW_PUBLIC_KEY_EXPO_SANDBOX=
FLW_SECRET_KEY_EXPO_SANDBOX=
FLW_ENCRYPTION_KEY_EXPO_SANDBOX=
FLW_WEBHOOK_HASH_EXPO_SANDBOX=
FLW_PUBLIC_KEY_EXPO_LIVE=
FLW_SECRET_KEY_EXPO_LIVE=
FLW_ENCRYPTION_KEY_EXPO_LIVE=
FLW_WEBHOOK_HASH_EXPO_LIVE=

# Flutterwave v4 shared credentials for all tenants.
# Use these when all tenants share the same Flutterwave dashboard account.
FLW_CLIENT_ID_SANDBOX=
FLW_CLIENT_SECRET_SANDBOX=
FLW_ENCRYPTION_KEY_SANDBOX=
FLW_WEBHOOK_HASH_SANDBOX=
FLW_CLIENT_ID_LIVE=
FLW_CLIENT_SECRET_LIVE=
FLW_ENCRYPTION_KEY_LIVE=
FLW_WEBHOOK_HASH_LIVE=

# Optional shared fallback for all tenants using legacy v3 keys.
FLW_PUBLIC_KEY_SANDBOX=
FLW_SECRET_KEY_SANDBOX=
FLW_PUBLIC_KEY_LIVE=
FLW_SECRET_KEY_LIVE=

# --- Mail (platform-native /mail UI + SMTP sending + Maildir indexing) ---
# Default mail domain used for agent mailboxes
MAIL_DOMAIN=boursedelor.com
# Maildir base path inside the app container (used by the indexer + provisioning metadata)
MAILDIR_BASE=/var/mail
# Optional: Postgres-backed virtual users/domains/aliases (NOT used by file-backed docker-mailserver)
MAIL_DATABASE_URL=
# Default agent mailbox key used when /api/mail is called without agentKey
MAIL_DEFAULT_AGENT_KEY=support

# Outbound email via SMTP submission (recommended)
MAIL_SMTP_HOST=mail.boursedelor.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Alternatively, use local sendmail binary instead of SMTP
MAIL_SMTP_SENDMAIL=false
MAIL_SMTP_SENDMAIL_PATH=

# Platform signature secret for internal headers
MAIL_PLATFORM_SIGNATURE_SECRET=generate_a_long_random_secret

# --- Mailserver provisioning (docker-mailserver on the VPS) ---
# Enables /api/admin/email/accounts provisioning via docker exec into the mailserver container.
# Requires mounting the docker socket into the app container (see docker-compose.yml).
MAILSERVER_CONTAINER_NAME=mailserver
MAILSERVER_DOCKER_SOCKET_PATH=/var/run/docker.sock

# IMAP auth verification after provisioning (optional but recommended)
MAILSERVER_IMAP_HOST=mail.exportunity.net
MAILSERVER_IMAP_PORT=993
# Set true only if you have TLS issues and understand the risk (disables cert validation)
MAILSERVER_IMAP_TLS_INSECURE=false

# Mail indexer scheduler (indexes Maildir -> app DB)
MAIL_INDEXER_ENABLED=true
MAIL_INDEXER_INTERVAL_MS=300000
MAIL_INDEXER_LIMIT_PER_MAILBOX=100

# --- Actions worker (processes queued Action Requests like SEND_EMAIL/SEND_SMS/SEND_WHATSAPP) ---
ACTIONS_WORKER_ENABLED=true
ACTIONS_WORKER_INTERVAL_MS=2000
ACTIONS_WORKER_MAX_BATCH=50
ACTIONS_WORKER_INITIAL_DELAY_MS=1500

# --- Engineering Kernel (autonomous machine compiler + node execution) ---
# Internal-only endpoints (/engineering/*) require this header:
#   X-Engineering-Kernel-Key: <ENGINEERING_KERNEL_INTERNAL_KEY>
ENGINEERING_KERNEL_INTERNAL_KEY=generate_a_long_random_secret

# Private UI access point (/machinery). Must remain OFF by default.
ENGINEERING_KERNEL_UI_ENABLED=false

# Where execution artifacts are written (optional; falls back to ASSET_ROOT/ASSET_BASE_PATH then ./tmp)
ENGINEERING_ARTIFACTS_ROOT=
# Agent Management V2 + Department Manager Chat
FEATURE_AGENT_MGMT_V2=true
FEATURE_DEPARTMENT_MANAGER_CHAT=true
FEATURE_AGENT_MARKETPLACE_SPLIT=true
FEATURE_AGENT_MODEL_SELECTOR=true

# Action Forge
FEATURE_ACTION_FORGE=true
FEATURE_ACTION_FORGE_AUTO_MERGE=false
FEATURE_ACTION_REGISTRY_ENFORCEMENT=true
ACTION_FORGE_DAILY_LIMIT=20
PROTECTED_TABLES=[\"users\",\"wallets\",\"payments\",\"ledger_entries\"]

# Workstations monitoring
FEATURE_WORKSTATIONS=true
FEATURE_WORKSTATION_MONITORING=true
WORKSTATION_AUTO_SHUTDOWN_ENABLED=true
WORKSTATION_AUTO_SHUTDOWN_MINUTES=10
WORKSTATION_AUTO_SHUTDOWN_WARNING_MINUTES=2

# --- Maison en Terre (tenant: met) ---
ADMIN_EMAIL=admin@maisonenterre.com
ADMIN_SEED_PASSWORD=ChangeMeNow!
UPLOAD_DIR=/data/uploads
MET_WHATSAPP_NUMBER=22901010101
MET_DEFAULT_COUNTRY=BJ
# Optional pricing defaults (can also be overridden in met_settings table)
MET_PRICING_DEFAULT_DELIVERY_FEE_CFA=25000
MET_PRICING_INCLUDED_RADIUS_KM=15
MET_PRICING_EXTRA_FEE_PER_KM_CFA=1200
MET_PRICING_BRICKS_PER_M2=50

# --- AGOOJIYE Mobility Platform (tenant: agoojye) ---
AGOOJIYE_APP_URL=https://agoojiye.com
AGOOJIYE_OS_URL=https://agoojiye.com
AGOOJIYE_WORKOS_URL=https://agoojiye.com/workspace
AGOOJIYE_SUPER_ADMIN_EMAIL=vs@agoojiye.com
# At least 32 random bytes. Used only to encrypt TOTP secrets at rest.
AGOOJIYE_MFA_ENCRYPTION_KEY=
AGOOJIYE_PRIVILEGED_SESSION_HOURS=8
AGOOJIYE_WORKOS_SESSION_HOURS=168
AGOOJIYE_WORKER_IMPORT_MAX_MB=5
AGOOJIYE_ASSISTANT_TIMEZONE=Africa/Porto-Novo
AGOOJIYE_ASSISTANT_DAILY_BRIEF=07:30
AGOOJIYE_ASSISTANT_WEEKLY_REPORT=MON 08:00
AGOOJIYE_WEBMAIL_URL=https://mail.agoojiye.com/
AGOOJIYE_DEFAULT_CURRENCY=XOF
AGOOJIYE_BOOKING_HOLD_MINUTES=15
AGOOJIYE_TICKET_SIGNING_SECRET=generate_a_unique_64_character_secret
AGOOJIYE_PAYMENT_PROVIDER=demo
AGOOJIYE_DEMO_PAYMENT_MODE=true
AGOOJIYE_EMAIL_PROVIDER=roundcube
AGOOJIYE_SMTP_HOST=mail.agoojiye.com
# Store real values only in the deployment secret store. These variables are
# referenced by the five human sender identities and must never be committed.
AGOOJIYE_MAILBOX_REGIS_PASSWORD=
AGOOJIYE_MAILBOX_SORIANE_PASSWORD=
AGOOJIYE_MAILBOX_MARYSE_PASSWORD=
AGOOJIYE_MAILBOX_CHRISTIAN_PASSWORD=
AGOOJIYE_MAILBOX_VITAL_PASSWORD=
AGOOJIYE_MAILBOX_VS_PASSWORD=
AGOOJIYE_JOB_WORKER_ENABLED=true
AGOOJIYE_JOB_WORKER_INTERVAL_MS=30000
AGOOJIYE_JOB_WORKER_MAX_BATCH=5
AGOOJIYE_SMS_PROVIDER=disabled
AGOOJIYE_WHATSAPP_PROVIDER=disabled
AGOOJIYE_SUPPORT_PHONE=+2290100000000
AGOOJIYE_SUPPORT_EMAIL=support@agoojiye.com
# Leave empty to use the procedural placeholder on /experience-3d.
AGOOJIYE_3D_MODEL_URL=
# Optional Web Push for AGOOJIYE OS. Generate once with:
# npx web-push generate-vapid-keys --json
AGOOJIYE_VAPID_PUBLIC_KEY=
AGOOJIYE_VAPID_PRIVATE_KEY=
AGOOJIYE_VAPID_SUBJECT=mailto:support@agoojiye.com
